  "cards": [
    {
      "dot": "amber",
      "title": "Evidence and legend",
      "items": [
        "Every AWS symbol is an official AWS Architecture Icon; arrows describe declarations, not live traffic.",
        "Terraform owns foundations. Six /24 subnets across two illustrative AZs do not prove availability."
      ]
    },
    {
      "dot": "rose",
      "title": "Network limits",
      "items": [
        "Three route tables; only public has an Internet default route. Public IP auto-assignment is false in all tiers.",
        "Default SG denies ingress and egress. The app-to-database rule attaches no workload. No NAT, EKS, EC2, RDS or load balancer is declared."
      ]
    },
    {
      "dot": "cyan",
      "title": "Separate storage boundary",
      "items": [
        "Report bucket, KMS and unattached IAM policy are regional/account services outside the VPC. No S3 endpoint is declared.",
        "No local lab connection to AWS. Mock provider checks are recorded in G1/G2-A evidence; no AWS provisioning or availability check."
      ]
    }
  ]
